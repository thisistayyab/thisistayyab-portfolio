# Copy these into Vercel → Project → Settings → Environment Variables
# Apply to Production, Preview, and Development as needed.
#
# https://vercel.com/docs/projects/environment-variables

# Supabase (dynamic blog — required for /blog and /dashboard/blog)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2G8GTSVY0L

# EmailJS (contact form on /contact)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
