# Copy these into Vercel → Project → Settings → Environment Variables
# Apply to Production, Preview, and Development as needed.
#
# https://vercel.com/docs/projects/environment-variables

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2G8GTSVY0L

# Search Console / Bing Webmaster (optional — pick meta tag OR file per provider)
# Google meta tag: content value only (HTML tag method in Search Console)
GOOGLE_SITE_VERIFICATION=
# Google HTML file: exact filename from Search Console + same token as in file body
GOOGLE_SITE_VERIFICATION_FILE=
# Bing meta tag only if you are NOT using public/BingSiteAuth.xml
BING_SITE_VERIFICATION=
# Yandex (optional)
YANDEX_SITE_VERIFICATION=

# EmailJS (contact form on /contact)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
